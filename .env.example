# ==============================================================================
# VINCULACION UAE - VARIABLES DE ENTORNO (.env.local)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS (POSTGRESQL / SEQUELIZE)
# ------------------------------------------------------------------------------
# Cadena de conexión directa completa (recomendada para Neon / Supabase / Render / AWS):
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/vinculacion?sslmode=require

# Parámetros individuales (se usan si DATABASE_URL no está definida):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_SSL=true

# Sincronización automática de modelos Sequelize al iniciar el servidor (true | false)
DB_AUTO_SYNC=false

# ------------------------------------------------------------------------------
# 2. SUPABASE
# ------------------------------------------------------------------------------
# URL y llave anónima de tu proyecto en Supabase (usado para APIs y almacenamiento)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# ------------------------------------------------------------------------------
# 3. BACKEND & RUTAS DE API
# ------------------------------------------------------------------------------
# URL base para los endpoints de oficios y autenticación (en local puede ser /api/applications)
NEXT_PUBLIC_URL_OFICIO_BACKEND=/api/applications

# Llave secreta para la firma y verificación de tokens JWT de sesión
NEXT_PUBLIC_JWT_SECRET=super_secret_jwt_key_segura_123456

# ------------------------------------------------------------------------------
# 4. AUTENTICACIÓN GOOGLE (OAuth)
# ------------------------------------------------------------------------------
# Client ID de Google Cloud Console para el inicio de sesión con Google
NEXT_PUBLIC_GOOGLE_CLIENT_ID=tu_cliente_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 5. INTELIGENCIA ARTIFICIAL (GEMINI Y GROQ)
# ------------------------------------------------------------------------------
# Google Gemini API (para el chatbot institucional y asistentes)
GEMINI_API_KEY=AIzaSy...tu_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Groq Cloud API (para generación de temas e informes técnicos)
NEXT_PUBLIC_API_GROQ_KEY=gsk_...tu_groq_api_key
NEXT_PUBLIC_GROQ_MODEL=qwen/qwen3.8-27b

# ------------------------------------------------------------------------------
# 6. SERVICIO DE CORREO TRANSACCIONAL (BREVO / SENDINBLUE)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BREVO_API_KEY=xkeysib-...tu_api_key_de_brevo
NEXT_PUBLIC_BREVO_API_URL=https://api.brevo.com/v3/smtp/email
NEXT_PUBLIC_BREVO_SENDER_EMAIL=vinculacion@uagraria.edu.ec
NEXT_PUBLIC_BREVO_SENDER_NAME=Vinculación UAE
NEXT_PUBLIC_RECIPIENT_EMAIL=mario.ibarra.86@gmail.com

# ------------------------------------------------------------------------------
# 7. CONTACTOS Y FIRMAS INSTITUCIONALES (CHATBOT Y DOCUMENTOS)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RESPONSABLE_NOMBRE=Ing. Mario Ibarra
NEXT_PUBLIC_RESPONSABLE_EMAIL=mibarra@uagraria.edu.ec
NEXT_PUBLIC_SECRETARIA_NOMBRE=Secretaría de Decanato
NEXT_PUBLIC_DEPARTAMENTO_ENCARGADO=Ing. Johanna Ramos
NEXT_PUBLIC_COORDINADORA_NOMBRE=Ing. Laura Ortega
